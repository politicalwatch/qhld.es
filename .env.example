NUXT_PUBLIC_SITE_URL=https://www.quehacenlosdiputados.es
NUXT_PUBLIC_SHORTNAME=qhld
NUXT_PUBLIC_BACKEND_URL=https://api.quehacenlosdiputados.es
NUXT_PUBLIC_HOMEBUILDER_URL=https://homebuilder.quehacenlosdiputados.es
NUXT_PUBLIC_USE_ALERTS=true
NUXT_PUBLIC_KNOWLEDGEBASE=politicas
NUXT_PUBLIC_GTAG_ID=
NUXT_OG_IMAGE_SECRET=
# Server-only shared secret for submitting search ratings. Must match the backend's
# SEARCH_RATING_TOKEN. Read at RUNTIME, so it has to be in the container's environment
# (a CI secret alone never reaches the running container). Empty disables submitting.
NUXT_SEARCH_RATING_TOKEN=
